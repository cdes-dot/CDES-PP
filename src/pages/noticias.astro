---
import Layout from '../layouts/Layout.astro';
import { Card, CardContent, CardHeader } from '@/components/ui/card';
import { getData } from 'lib/fetch';
export const prerender = false
import { Calendar, User, ChevronLeft, ChevronRight } from 'lucide-react';

// Obtener parámetros de la URL
const url = new URL(Astro.request.url);
const currentPage = parseInt(url.searchParams.get('page') || '1');
const itemsPerPage = 6; // Número de noticias por página

const data = await getData("articulos?populate=*");

// Calcular paginación
const totalItems = data.length;
const totalPages = Math.ceil(totalItems / itemsPerPage);
const startIndex = (currentPage - 1) * itemsPerPage;
const endIndex = startIndex + itemsPerPage;
const currentNews = data.slice(startIndex, endIndex);

// Generar números de página para mostrar
const getPageNumbers = () => {
    const pages = [];
    const maxVisiblePages = 5;

    if (totalPages <= maxVisiblePages) {
        for (let i = 1; i <= totalPages; i++) {
            pages.push(i);
        }
    } else {
        let start = Math.max(1, currentPage - 2);
        let end = Math.min(totalPages, currentPage + 2);

        if (currentPage <= 3) {
            end = maxVisiblePages;
        } else if (currentPage >= totalPages - 2) {
            start = totalPages - maxVisiblePages + 1;
        }

        for (let i = start; i <= end; i++) {
            pages.push(i);
        }
    }

    return pages;
};

const pageNumbers = getPageNumbers();
---

<Layout>
    <main class="min-h-screen bg-background py-16">
        <div class="container mx-auto max-w-4xl px-6">
            <!-- Header -->
            <div class="text-center mb-12">
                <h1 class="text-4xl font-bold mb-4 font-playfair">
                    Noticias CDES
                </h1>
                <p class="text-muted-foreground text-lg font-inter">
                    Mantente al día con las últimas noticias del Consejo para el Desarrollo Estratégico de Santiago
                </p>
                <p class="text-sm text-muted-foreground mt-2">
                    Mostrando {startIndex + 1}-{Math.min(endIndex, totalItems)} de {totalItems} noticias
                </p>
            </div>

            <!-- Lista vertical de noticias -->
            <div class="space-y-8 mb-12">
                {currentNews.map((noticia: any, index: number) => (
                    <Card className="overflow-hidden hover:shadow-lg transition-shadow duration-300">
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-0">
                            <div class="md:col-span-1">
                                <div class="aspect-video md:aspect-square overflow-hidden">
                                    <img
                                        src={noticia.Portada?.url.replace("https", "https:")}
                                        alt={noticia.Titulo}
                                        class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
                                    />
                                </div>
                            </div>

                            <!-- Contenido -->
                            <div class="md:col-span-2 p-6">
                                <!-- Badge de posición -->
                                <div class="flex items-center mb-3">
                                    <span class="bg-primary text-primary-foreground text-xs px-2 py-1 rounded-full font-medium">
                                        #{startIndex + index + 1}
                                    </span>
                                    <div class="ml-auto flex items-center space-x-1 text-xs text-muted-foreground">
                                        <Calendar className="w-4 h-4" />
                                        <span>{noticia.Creacion}</span>
                                    </div>
                                </div>

                                <!-- Título -->
                                <h2 class="text-2xl font-semibold mb-3 line-clamp-2 font-noto">
                                    <a
                                        href={`/noticias/${noticia.documentId}`}
                                        class="hover:text-primary transition-colors"
                                    >
                                        {noticia.Titulo}
                                    </a>
                                </h2>

                                <!-- Descripción -->
                                {noticia.Content?.[0]?.children?.map((paragraph: any, pIndex: number) => (
                                    pIndex === 0 && (
                                        <p class="text-muted-foreground text-base mb-4 line-clamp-3 font-inter leading-relaxed">
                                            {paragraph.text}
                                        </p>
                                    )
                                ))}

                                <!-- Metadata y botón -->
                                <div class="flex items-center justify-between">
                                    <div class="flex items-center space-x-1 text-sm text-muted-foreground">
                                        <User className="w-4 h-4" />
                                        <span>{noticia.autor?.Nombre || 'CDES'}</span>
                                    </div>

                                    <a
                                        href={`/noticias/${noticia.documentId}`}
                                        class="text-primary hover:text-primary/80 text-sm font-medium transition-colors"
                                    >
                                        Leer más →
                                    </a>
                                </div>
                            </div>
                        </div>
                    </Card>
                ))}
            </div>

            <!-- Paginación -->
            {totalPages > 1 && (
                <nav class="flex justify-center items-center space-x-2">
                    <!-- Botón Anterior -->
                    {currentPage > 1 ? (
                        <a
                            href={`/noticias?page=${currentPage - 1}`}
                            class="flex items-center px-3 py-2 text-sm font-medium text-muted-foreground bg-background border border-border rounded-md hover:bg-accent hover:text-accent-foreground transition-colors"
                        >
                            <ChevronLeft className="w-4 h-4 mr-1" />
                            Anterior
                        </a>
                    ) : (
                        <span class="flex items-center px-3 py-2 text-sm font-medium text-muted-foreground/50 bg-background border border-border rounded-md cursor-not-allowed">
                            <ChevronLeft className="w-4 h-4 mr-1" />
                            Anterior
                        </span>
                    )}

                    <!-- Números de página -->
                    <div class="flex space-x-1">
                        {pageNumbers.map((pageNum) => (
                            pageNum === currentPage ? (
                                <span class="px-3 py-2 text-sm font-medium text-primary-foreground bg-primary border border-primary rounded-md">
                                    {pageNum}
                                </span>
                            ) : (
                                <a
                                    href={`/noticias?page=${pageNum}`}
                                    class="px-3 py-2 text-sm font-medium text-muted-foreground bg-background border border-border rounded-md hover:bg-accent hover:text-accent-foreground transition-colors"
                                >
                                    {pageNum}
                                </a>
                            )
                        ))}
                    </div>

                    <!-- Botón Siguiente -->
                    {currentPage < totalPages ? (
                        <a
                            href={`/noticias?page=${currentPage + 1}`}
                            class="flex items-center px-3 py-2 text-sm font-medium text-muted-foreground bg-background border border-border rounded-md hover:bg-accent hover:text-accent-foreground transition-colors"
                        >
                            Siguiente
                            <ChevronRight className="w-4 h-4 ml-1" />
                        </a>
                    ) : (
                        <span class="flex items-center px-3 py-2 text-sm font-medium text-muted-foreground/50 bg-background border border-border rounded-md cursor-not-allowed">
                            Siguiente
                            <ChevronRight className="w-4 h-4 ml-1" />
                        </span>
                    )}
                </nav>
            )}
        </div>
    </main>
</Layout>
