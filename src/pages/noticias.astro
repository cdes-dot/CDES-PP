---
export const prerender = false

import Layout from '../layouts/Layout.astro';
import { Card, CardContent, CardHeader } from '@/components/ui/card';
import { getData } from 'lib/fetch';
import { Calendar, User, ChevronLeft, ChevronRight, MoreHorizontal } from 'lucide-react';
import NewsSection from "@/components/News";

// Obtener parámetros de la URL
const url = new URL(Astro.request.url);
const currentPage = parseInt(url.searchParams.get('page') || '1');
const itemsPerPage = 9; // Número de noticias por página

const [data,meta] = await getData(`articulos?populate=*&pagination[page]=${currentPage}&pagination[pageSize]=9&sort=Creacion:desc`, true);
const {Encabezado } = await getData("Noticia?populate[Encabezado][populate][articulos][populate]=*")
// Calcular paginación
const totalItems = data.length;
const totalPages = Math.ceil(meta.pagination.total / itemsPerPage);
const startIndex = (currentPage - 1) * itemsPerPage;
const endIndex = startIndex + itemsPerPage;
const currentNews = data;

// Generar números de página para mostrar con puntos suspensivos
// Generar números de página para mostrar
// Generar números de página para mostrar
// Generar números de página para mostrar
const getPaginationItems = () => {
    const items = [];

    // Versión simple para debugging
    if (totalPages <= 7) {
        // Mostrar todas las páginas
        for (let i = 1; i <= totalPages; i++) {
            items.push(i);
        }
    } else {
        // Mostrar 1 ... páginas_centrales ... última
        items.push(1);
        if (currentPage > 4) items.push('ellipsis');

        const start = Math.max(2, currentPage - 1);
        const end = Math.min(totalPages - 1, currentPage + 1);

        for (let i = start; i <= end; i++) {
            if (!items.includes(i)) items.push(i);
        }

        if (currentPage < totalPages - 3) items.push('ellipsis');
        if (!items.includes(totalPages)) items.push(totalPages);
    }

    return items;
};


const paginationItems = getPaginationItems();
---

<Layout>
    <main class="min-h-screen bg-background py-16">
        <div class="mx-auto w-screen px-6">
            <!-- Header -->
            <div class="text-center mb-12">
                <h1 class="text-4xl font-bold mb-4 font-playfair">
                    {Encabezado.Titulo}
                </h1>
                <p class="text-muted-foreground text-lg font-inter">
                    {Encabezado.Subtitulo}
                </p>
                <p class="text-sm text-muted-foreground mt-2">
                    Página {currentPage} de {totalPages} • Mostrando {startIndex + 1}-{Math.min(endIndex, totalItems)} de {totalItems} noticias
                </p>
            </div>

            <NewsSection
            button={false}
                news={Encabezado.articulos}
                title={""}
                subtitle={""}
                client:only
            />
            <!-- Lista vertical de noticias -->
            <div class="mt-10 space-y-8 mb-12 grid lg:grid-cols-3 md:grid-cols-2 grid-cols-1 gap-4 ">
                {currentNews.map((noticia: any, index: number) => (
                    <Card className="overflow-hidden hover:shadow-lg transition-shadow duration-300 md:max-h-[316px] min-h-[316px]">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-0">
                            <div class="md:col-span-1 md:hidden">
                                <div class="aspect-video md:aspect-square overflow-hidden h-full">
                                    <img
                                        src={noticia.Portada?.url}
                                        alt={noticia.Titulo}
                                        class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
                                    />
                                </div>
                            </div>

                            <!-- Contenido -->
                            <div class="md:col-span-2 p-6">
                                <!-- Badge de posición -->
                                <div class="flex items-center mb-3">
                                    <div class="ml-auto flex items-center space-x-1 text-xs text-muted-foreground">
                                        <Calendar className="w-4 h-4" />
                                        <span>{noticia.Creacion}</span>
                                    </div>
                                </div>

                                <!-- Título -->
                                <h2 class="text-2xl font-semibold mb-3 line-clamp-2 font-noto">
                                    <a
                                        href={`/noticias/${noticia.documentId}`}
                                        class="hover:text-primary transition-colors"
                                    >
                                        {noticia.Titulo}
                                    </a>
                                </h2>

                                <!-- Descripción -->
                                {noticia.Content?.[0]?.children?.map((paragraph: any, pIndex: number) => (
                                    pIndex === 0 && (
                                        <p class="text-muted-foreground text-base mb-4 line-clamp-3 font-inter leading-relaxed">
                                            {paragraph.text}
                                        </p>
                                    )
                                ))}

                                <!-- Metadata y botón -->
                                <div class="flex items-center justify-between">
                                    <div class="flex items-center space-x-1 text-sm text-muted-foreground">
                                        <User className="w-4 h-4" />
                                        <span>{noticia.autor?.Nombre || 'CDES'}</span>
                                    </div>

                                    <a
                                        href={`/noticias/${noticia.documentId}`}
                                        class="text-primary hover:text-primary/80 text-sm font-medium transition-colors"
                                    >
                                        Leer más →
                                    </a>
                                </div>
                            </div>
                        </div>
                    </Card>
                ))}
            </div>

            <!-- Paginación Mejorada -->
            {totalPages > 1 && (
                <nav class="flex flex-col sm:flex-row justify-center items-center space-y-4 sm:space-y-0 sm:space-x-2">
                    <!-- Información de página en móvil -->
                    <div class="sm:hidden text-sm text-muted-foreground mb-4">
                        Página {currentPage} de {totalPages}
                    </div>

                    <div class="flex items-center space-x-1">
                        <!-- Botón Anterior -->
                        {currentPage > 1 ? (
                            <a
                                href={`/noticias?page=${currentPage - 1}`}
                                class="flex items-center px-3 py-2 text-sm font-medium text-muted-foreground bg-background border border-border rounded-md hover:bg-accent hover:text-accent-foreground transition-colors"
                            >
                                <ChevronLeft className="w-4 h-4 mr-1" />
                                <span class="hidden sm:inline">Anterior</span>
                            </a>
                        ) : (
                            <span class="flex items-center px-3 py-2 text-sm font-medium text-muted-foreground/50 bg-background border border-border rounded-md cursor-not-allowed">
                                <ChevronLeft className="w-4 h-4 mr-1" />
                                <span class="hidden sm:inline">Anterior</span>
                            </span>
                        )}

                        <!-- Números de página con puntos suspensivos -->
                        <div class="flex space-x-1">
                            {paginationItems.map((item, index) => (
                              item === 'ellipsis' ? (
                                <span  class="px-3 py-2 text-sm font-medium text-muted-foreground">
                                  <MoreHorizontal className="w-4 h-4" />
                                </span>
                              ) : item === currentPage ? (
                                <span  class="px-3 py-2 text-sm font-medium text-primary-foreground bg-primary border border-primary rounded-md">
                                  {item}
                                </span>
                              ) : (
                                <a

                                  href={`/noticias?page=${item}`}
                                  class="px-3 py-2 text-sm font-medium text-muted-foreground bg-background border border-border rounded-md hover:bg-accent hover:text-accent-foreground transition-colors"
                                >
                                  {item}
                                </a>
                              )
                            ))}

                        </div>
                        <!-- Botón Siguiente -->
                        {currentPage < totalPages ? (
                            <a
                                href={`/noticias?page=${currentPage + 1}`}
                                class="flex items-center px-3 py-2 text-sm font-medium text-muted-foreground bg-background border border-border rounded-md hover:bg-accent hover:text-accent-foreground transition-colors"
                            >
                                <span class="hidden sm:inline">Siguiente</span>
                                <ChevronRight className="w-4 h-4 ml-1" />
                            </a>
                        ) : (
                            <span class="flex items-center px-3 py-2 text-sm font-medium text-muted-foreground/50 bg-background border border-border rounded-md cursor-not-allowed">
                                <span class="hidden sm:inline">Siguiente</span>
                                <ChevronRight className="w-4 h-4 ml-1" />
                            </span>
                        )}
                    </div>

                    <!-- Navegación rápida -->
                    <div class="flex items-center space-x-2 text-sm">
                        {currentPage > 3 && (
                            <a
                                href="/noticias?page=1"
                                class="text-primary hover:text-primary/80 transition-colors"
                            >
                                ← Primera
                            </a>
                        )}
                        {currentPage < totalPages - 2 && (
                            <a
                                href={`/noticias?page=${totalPages}`}
                                class="text-primary hover:text-primary/80 transition-colors"
                            >
                                Última →
                            </a>
                        )}
                    </div>
                </nav>
            )}
        </div>
    </main>
</Layout>
```
