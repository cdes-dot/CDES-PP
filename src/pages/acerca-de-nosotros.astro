---
import Layout from "@/layouts/Layout.astro";
export const prerender = false;
import { Timeline } from "../components/Timeline";
import { getData } from "lib/fetch";

let Titulo = "";
let Historia: any[] = [];
let Evento: any[] = [];
let Infografia: any = null;
let MisionVisionObjetivo: any = null;
let Miembros: any[] = [];
let EquipoTecnicos: any[] = [];

const getBlockTexts = (blocks: any[] = []) => {
    if (!Array.isArray(blocks)) return [];

    return blocks.flatMap((block: any) => {
        if (!Array.isArray(block?.children)) return [];
        return block.children
            .map((item: any) => item?.text)
            .filter((text: string) => typeof text === "string" && text.trim().length > 0);
    });
};

try {
    console.log("🔄 Cargando datos de acerca-de...");

    // Obtener todos los datos desde acerca-de con populate completo
    const data = await getData(
        "acerca-de?populate[Miembros][populate][Portada]=true" +
        "&populate[Miembros][populate][institucion]=true" +
        "&populate[equipo_tecnicos][populate][Portada]=true" +
        "&populate[Infografia]=true" +
        "&populate[Mision_Vision_Objeitvo]=true" +
        "&populate[Evento]=true"
    );
    
    console.log("📦 Estructura de datos recibida:", {
        keys: Object.keys(data || {}),
        Titulo: data?.Titulo,
        Historia: !!data?.Historia,
        Mision_Vision_Objeitvo: !!data?.Mision_Vision_Objeitvo,
        Evento: !!data?.Evento,
        Infografia: !!data?.Infografia,
        Miembros: !!data?.Miembros,
        equipo_tecnicos: !!data?.equipo_tecnicos
    });

    // Datos básicos
    Titulo = data?.Titulo || "Acerca de Nosotros";
    Historia = data?.Historia || [];
    Evento = data?.Evento || [];

    // Procesar infografía
    if (data?.Infografia?.url) {
        Infografia = {
            url: data.Infografia.url.startsWith('http')
                ? data.Infografia.url
                : `${import.meta.env.PUBLIC_STRAPI_URL}${data.Infografia.url}`
        };
    } else if (data?.Infografia?.data?.attributes?.url) {
        Infografia = {
            url: `${import.meta.env.PUBLIC_STRAPI_URL}${data.Infografia.data.attributes.url}`
        };
    }

    // Procesar imagen de Misión / Visión / Objetivo
    if (data?.Mision_Vision_Objeitvo?.url) {
        MisionVisionObjetivo = {
            url: data.Mision_Vision_Objeitvo.url.startsWith('http')
                ? data.Mision_Vision_Objeitvo.url
                : `${import.meta.env.PUBLIC_STRAPI_URL}${data.Mision_Vision_Objeitvo.url}`
        };
    } else if (data?.Mision_Vision_Objeitvo?.data?.attributes?.url) {
        MisionVisionObjetivo = {
            url: `${import.meta.env.PUBLIC_STRAPI_URL}${data.Mision_Vision_Objeitvo.data.attributes.url}`
        };
    }

    // 🆕 Procesar miembros desde acerca-de (no endpoint separado)
    if (data?.Miembros) {
        console.log("🔍 Procesando Miembros desde acerca-de...");
        console.log("📋 Raw Miembros data:", JSON.stringify(data.Miembros, null, 2));
        if (Array.isArray(data.Miembros)) {
            Miembros = data.Miembros.map((item: any) => ({
                id: item.id,
                Nombres: item.Nombres,
                Apellidos: item.Apellidos,
                Portada: item.Portada?.url ? {
                    url: item.Portada.url  // URL ya viene completa
                } : null,
                institucion: item.institucion ? {
                    Nombre: item.institucion.Nombre,
                    Url: item.institucion.Url  // También tiene Url si la quieres usar
                } : null,
                puesto: item.Puesto || null  // Puesto con mayúscula
            }));
        } else if (data.Miembros.data) {
            Miembros = data.Miembros.data.map((item: any) => {
                console.log("👤 Procesando miembro (data):", item.attributes?.Nombres, "- puesto raw:", item.attributes?.puesto, "- Puesto raw:", item.attributes?.Puesto);
                return {
                    id: item.id,
                    Nombres: item.attributes?.Nombres,
                    Apellidos: item.attributes?.Apellidos,
                    Portada: item.attributes?.Portada?.data ? {
                        url: `${import.meta.env.PUBLIC_STRAPI_URL}${item.attributes.Portada.data.attributes.url}`
                    } : null,
                    institucion: item.attributes?.institucion?.data ? {
                        Nombre: item.attributes.institucion.data.attributes.Nombre
                    } : null,
                    puesto: item.attributes?.puesto || item.attributes?.Puesto || null
                };
            });
        }
    }

    // 🆕 Procesar equipo técnico desde acerca-de (no endpoint separado)
    if (data?.equipo_tecnicos) {
        console.log("🔍 Procesando Equipo Técnico desde acerca-de...");
        console.log("📋 Raw Equipo Técnico data:", JSON.stringify(data.equipo_tecnicos, null, 2));
        if (Array.isArray(data.equipo_tecnicos)) {
            EquipoTecnicos = data.equipo_tecnicos.map((item: any) => ({
                id: item.id,
                Nombre: item.Nombre,
                Apellidos: item.Apellidos,
                Contacto: item.Contacto,
                Portada: item.Portada?.url ? {
                    url: item.Portada.url  // URL ya viene completa
                } : null,
                puesto: item.Puesto || null  // Puesto con mayúscula
            }));
        } else if (data.equipo_tecnicos.data) {
            EquipoTecnicos = data.equipo_tecnicos.data.map((item: any) => {
                console.log("👨‍💻 Procesando equipo técnico (data):", item.attributes?.Nombre, "- puesto raw:", item.attributes?.puesto, "- Puesto raw:", item.attributes?.Puesto);
                return {
                    id: item.id,
                    Nombre: item.attributes?.Nombre,
                    Apellidos: item.attributes?.Apellidos,
                    Contacto: item.attributes?.Contacto,
                    Portada: item.attributes?.Portada?.data ? {
                        url: `${import.meta.env.PUBLIC_STRAPI_URL}${item.attributes.Portada.data.attributes.url}`
                    } : null,
                    puesto: item.attributes?.puesto || item.attributes?.Puesto || null
                };
            });
        }
    }

    console.log("✅ Datos procesados:");
    console.log("- Título:", Titulo);
    console.log("- Historia:", Historia?.length || 0);
    console.log("- Eventos:", Evento?.length || 0);
    console.log("- Infografía:", !!Infografia);
    console.log("- Misión / Visión / Objetivo:", !!MisionVisionObjetivo);
    console.log("- Miembros:", Miembros?.length || 0);
    console.log("🔍 Miembros procesados:", Miembros.map(m => ({ nombre: m.Nombres, puesto: m.puesto })));
    console.log("- Equipo Técnico:", EquipoTecnicos?.length || 0);
    console.log("🔍 Equipo Técnico procesado:", EquipoTecnicos.map(e => ({ nombre: e.Nombre, puesto: e.puesto })));

} catch (error) {
    console.error("❌ Error cargando datos:", error);
}
---

<Layout>
    <div class="bg-muted">
        <section
            class="scroll-py-16 py-16 md:scroll-py-32 md:py-32 bg-background"
        >
            <div class="mx-auto max-w-7xl px-6">
                <div
                    class="grid gap-y-12 px-2 lg:[grid-template-columns:2fr_auto] space-x-8 lg:grid-cols-2"
                >
                    <div class="text-center lg:text-left space-y-4">
                        <h1 class="mb-6 text-4xl font-semibold md:text-5xl">
                            {Titulo}
                        </h1>
                        
                        {/* Infografía en móvil */}
                        {Infografia && (
                            <img
                                src={Infografia.url}
                                alt="Infografía"
                                class="rounded-md object-cover mb-6 lg:hidden block w-full"
                                loading="lazy"
                            />
                        )}
                        
                        {/* Historia */}
                        <div class="space-y-4">
                            {getBlockTexts(Historia).length > 0 ? (
                                getBlockTexts(Historia).map((text: string) => (
                                    <p class="text-left text-sm leading-relaxed">
                                        {text}
                                    </p>
                                ))
                            ) : (
                                <p class="text-left text-sm leading-relaxed text-gray-600">
                                    No hay información de historia disponible.
                                </p>
                            )}
                        </div>
                    </div>
                    
                    {/* Infografía en desktop */}
                    <div class="hidden lg:block">
                        {Infografia && (
                            <img
                                src={Infografia.url}
                                alt="Infografía"
                                class="rounded-md object-cover w-full"
                                loading="lazy"
                            />
                        )}
                    </div>
                </div>
            </div>
        </section>

        <section class="py-12 md:py-16 bg-background">
            <div class="mx-auto max-w-7xl px-6">
                {MisionVisionObjetivo ? (
                    <img
                        src={MisionVisionObjetivo.url}
                        alt="Misión, Visión y Objetivo"
                        class="rounded-md object-cover w-full"
                        loading="lazy"
                    />
                ) : (
                    <p class="text-sm leading-relaxed text-gray-600 text-center">
                        No hay imagen de Misión, Visión y Objetivo disponible.
                    </p>
                )}
            </div>
        </section>

        <section class="py-16 md:py-24 bg-background">
            <div class="mx-auto max-w-7xl px-6">
                {/* Timeline de Eventos */}
                {Evento && Evento.length > 0 && (
                    <div class="mb-16">
                        <Timeline timeline={Evento} client:load />
                    </div>
                )}

                {/* Junta Directiva */}
                {Miembros && Miembros.length > 0 && (
                    <div class="mb-16">
                        <h2 class="text-3xl font-semibold text-center mb-8">Junta Directiva</h2>

                        <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
                            {Miembros.map((miembro: any) => (
                                <div class="bg-white dark:bg-muted rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-shadow duration-300">
                                    <div class="w-full aspect-square overflow-hidden bg-gray-200 dark:bg-gray-700">
                                        {miembro.Portada ? (
                                            <img
                                                src={miembro.Portada.url}
                                                alt={`${miembro.Nombres} ${miembro.Apellidos}`}
                                                class="h-full w-full object-cover object-top"
                                                loading="lazy"
                                            />
                                        ) : (
                                            <div class="h-full w-full bg-gray-300 dark:bg-gray-600 flex items-center justify-center">
                                                <svg class="w-16 h-16 text-gray-400" fill="currentColor" viewBox="0 0 24 24">
                                                    <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                                                </svg>
                                            </div>
                                        )}
                                    </div>
                                    <div class="p-6">
                                        <h3 class="text-lg font-semibold mb-2">
                                            {miembro.Nombres} {miembro.Apellidos}
                                        </h3>
                                        {miembro.institucion && (
                                            <p class="text-sm text-gray-600 dark:text-neutral-400 mb-2">
                                                {miembro.institucion.Nombre}
                                            </p>
                                        )}
                                        {miembro.puesto && (
                                            <span class="inline-block bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-100 text-xs px-2 py-1 rounded">
                                                {miembro.puesto}
                                            </span>
                                        )}
                                    </div>
                                </div>
                            ))}
                        </div>
                    </div>
                )}

                {/* Equipo Técnico */}
                {EquipoTecnicos && EquipoTecnicos.length > 0 && (
                    <div>
                        <h2 class="text-3xl font-semibold text-center mb-8">Equipo Técnico</h2>
                        <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
                            {EquipoTecnicos.map((miembro: any) => (
                                <div class="bg-white dark:bg-muted rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-shadow duration-300">
                                    <div class="w-full aspect-square overflow-hidden bg-gray-200 dark:bg-gray-700">
                                        {miembro.Portada ? (
                                            <img
                                                src={miembro.Portada.url}
                                                alt={`${miembro.Nombre} ${miembro.Apellidos}`}
                                                class="h-full w-full object-cover object-top"
                                                loading="lazy"
                                            />
                                        ) : (
                                            <div class="h-full w-full bg-gray-300 dark:bg-gray-600 flex items-center justify-center">
                                                <svg class="w-16 h-16 text-gray-400" fill="currentColor" viewBox="0 0 24 24">
                                                    <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                                                </svg>
                                            </div>
                                        )}
                                    </div>
                                    <div class="p-6">
                                        <h3 class="text-lg font-semibold mb-2">
                                            {miembro.Nombre} {miembro.Apellidos}
                                        </h3>
                                        {miembro.Contacto && (
                                            <p class="text-sm text-gray-600 dark:text-neutral-400 mb-2">
                                                {miembro.Contacto}
                                            </p>
                                        )}
                                        {miembro.puesto && (
                                            <span class="inline-block bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-100 text-xs px-2 py-1 rounded">
                                                {miembro.puesto}
                                            </span>
                                        )}
                                    </div>
                                </div>
                            ))}
                        </div>
                    </div>
                )}
            </div>
        </section>
    </div>
</Layout>

