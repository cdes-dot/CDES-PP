---
import Layout from "@/layouts/Layout.astro";
import { Timeline } from "../components/Timeline";
import { getData } from "lib/fetch";

const { Titulo, Historia, Evento } = await getData("acerca-de?populate=*");
const miembros = await getData("miembros?populate=*");
//console.log(Titulo)
// Datos de los miembros del CDES
 
---

<Layout>
    <div class="bg-muted">
        <section
            class="scroll-py-16 py-16 md:scroll-py-32 md:py-32 bg-background"
        >
            <div class="mx-auto max-w-7xl px-6">
                <div
                    class="grid gap-y-12 px-2 lg:[grid-template-columns:2fr_auto] space-x-8 grid-cols-2"
                >
                    <div class="text-center lg:text-left space-y-2">
                        <h1 class="mb-6 text-4xl font-semibold md:text-5xl">
                            {Titulo} 
                        </h1>
                        {
                            Historia.map((paragraph: any) => {
                                return paragraph.children.map((item: any) => (
                                    <p class="line leading-6 text-left text-sm/8">
                                        {item.text}
                                    </p>
                                ));
                            })
                        }
                    </div>
                    <div
                        class="divide-y divide-dashed sm:mx-auto max-w-2xl lg:mx-0"
                    >
                    </div>
                </div>
            </div>
        </section>
        <div class="mx-auto max-w-7xl px-6 ">
            <Timeline timeline={Evento} client:load />
        </div>

        <!-- Sección de Miembros del CDES -->
        <section class="py-16 md:py-24 bg-background">
            <div class="mx-auto max-w-7xl px-6">
                <div class="text-center mb-12">
                    <h2
                        class="text-3xl font-bold tracking-tight text-neutral-900 dark:text-neutral-50 sm:text-4xl"
                    >
                        Junta Directiva
                    </h2>
                    <p class="mt-4 text-lg text-neutral-600 dark:text-neutral-100 ">
                        Conoce a los miembros que lideran el Consejo para el
                        Desarrollo Estratégico de Santiago
                    </p>
                </div>

                <div
                    class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3"
                >
                    {
                        miembros.map((miembro: any) => (
                            <div class="bg-white dark:bg-muted text-gray-500 dark:text-neutral-50 rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-shadow duration-300">
                                <div class="aspect-w-1 aspect-h-1 w-full overflow-hidden bg-gray-200">
                                    <img
                                        src={import.meta.env.PUBLIC_STRAPI_URL + miembro.Portada.url}
                                        alt={`Foto de ${miembro.Nombres}`}
                                        class="h-110 w-full object-cover object-center"
                                        onerror="this.src='/miembros/default-avatar.jpg'"
                                    />
                                </div>
                                <div class="p-6">
                                    <h3 class="text-lg font-semibold  mb-2">
                                        {`${miembro.Nombres}\t${miembro.Apellidos}`}
                                    </h3>
                                    <p class="text-sm font-bold mb-1">
                                        {miembro.Posicion}
                                    </p>
                                    <p class="text-sm">
                                        {miembro.institucion.Nombre}
                                    </p>
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>
    </div>
</Layout>
