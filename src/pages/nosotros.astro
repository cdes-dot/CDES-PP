---
<Layout>
    <div class="bg-muted">
        <section
            class="scroll-py-16 py-16 md:scroll-py-32 md:py-32 bg-background"
        >
            <div class="mx-auto max-w-7xl px-6">
                <div
                    class="grid gap-y-12 px-2 lg:[grid-template-columns:2fr_auto] space-x-8 grid-cols-2"
                >
                    <div class="text-center lg:text-left space-y-2">
                        <h1 class="mb-6 text-4xl font-semibold md:text-5xl">
                            Consejo para el Desarrollo Estratégico de <span
                                class="leading-6">Santiago</span
                            >
                        </h1>
                        <p class="text-sm line leading-6 text-left">
                            El Consejo para el Desarrollo Estratégico de
                            Santiago (CDES) es una entidad no lucrativa, acogida
                            a la Ley 122-05, para la regulación y fomento de las
                            Asociaciones Sin Fines de Lucro. Fundado el 26 de
                            noviembre de 1997 por representantes de las
                            principales instituciones públicas, privadas y
                            ciudadanas del municipio de Santiago, fue
                            incorporado en 1998 mediante Decreto del Poder
                            Ejecutivo No. 57-98.
                        </p>
                        <p class="text-sm line leading-6 text-left">
                            Está integrado por más de 60 organizaciones y
                            munícipes independientes, que reúnen a todos los
                            sectores de la sociedad de Santiago: el
                            Ayuntamiento, el gobierno nacional y sus
                            representantes locales, el sector comercial y
                            empresarial, ONGs, instituciones culturales y
                            deportivas, grupos religiosos, Federaciones de
                            Juntas de Vecinos, organizaciones populares,
                            comunicadores, entre otros.
                        </p>
                        <p class="text-sm line leading-6 text-left">
                            Todas las instituciones que conforman el Consejo,
                            son representadas por una Junta Directiva de quince
                            miembros, electas cada dos años mediante Asamblea
                            Eleccionaria. Sobre esta reposa la toma de
                            decisiones, que se llevan a cabo en sesiones de
                            trabajo mensuales. La ejecución de las acciones
                            consensuadas por la Junta Directiva corresponde a la
                            Oficina Coordinadora, quienes se encargan del
                            seguimiento técnico y logístico de los proyectos
                            apoyados por el CDES.
                        </p>
                    </div>
                    <div
                        class="divide-y divide-dashed sm:mx-auto max-w-2xl lg:mx-0"
                    >
                    </div>
                </div>
            </div>
        </section>
        <div class="mx-auto max-w-7xl px-6 bg-muted">
            <Timeline client:load/>
        </div>
        
        <!-- Sección de Miembros del CDES -->
        <section class="py-16 md:py-24 bg-background">
            <div class="mx-auto max-w-7xl px-6">
                <div class="text-center mb-12">
                    <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
                        Junta Directiva
                    </h2>
                    <p class="mt-4 text-lg text-gray-600">
                        Conoce a los miembros que lideran el Consejo para el Desarrollo Estratégico de Santiago
                    </p>
                </div>
                
                <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
                    {miembros.map((miembro) => (
                        <div class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-shadow duration-300">
                            <div class="aspect-w-1 aspect-h-1 w-full overflow-hidden bg-gray-200">
                                <img
                                    src={miembro.foto}
                                    alt={`Foto de ${miembro.nombre}`}
                                    class="h-110 w-full object-cover object-center"
                                    onerror="this.src='/miembros/default-avatar.jpg'"
                                />
                            </div>
                            <div class="p-6">
                                <h3 class="text-lg font-semibold text-gray-900 mb-2">
                                    {miembro.nombre}
                                </h3>
                                <p class="text-sm font-medium text-blue-600 mb-1">
                                    {miembro.posicion}
                                </p>
                                <p class="text-sm text-gray-500">
                                    {miembro.organizacion}
                                </p>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </section>
    </div>
</Layout>
