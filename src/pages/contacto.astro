---
import { Card } from "@/components/ui/card";
import { Input } from "@/components/ui/input";
import { Textarea } from "@/components/ui/textarea";
import { Label } from "@/components/ui/label";

import { Button } from "@/components/ui/button";
import Layout from "@/layouts/Layout.astro";
---

<Layout>
    <section class="bg-muted py-15 sm:py-24 lg:py-32">
        <div class="mx-auto max-w-4xl px-4 lg:px-0">
            <h1 class="text-4xl font-semibold lg:text-5xl">
                Ayúdanos a dirigir tu consulta
            </h1>
            <p class="text-muted-foreground mt-4 text-lg">
                Te ayudaremos a encontrar el plan y precio adecuado para tu
                negocio.
            </p>
            <div class="mt-12 grid gap-12 lg:grid-cols-5">
                <div class="grid grid-cols-2 lg:col-span-2 lg:block lg:space-y-12">
                    <div class="flex flex-col justify-between space-y-6">
                        <div>
                            <h2 class="mb-3 text-lg font-semibold">
                                Colaborar
                            </h2>
                            <a
                                href="mailto:cdescomunica@cdes.do"
                                class="text-primary text-lg hover:underline"
                            >
                                cdescomunica@cdes.do
                            </a>
                            <p class="mt-3 text-sm">809-582-0335</p>
                        </div>
                        <!-- Mapa visible solo en desktop -->
                        <div class="hidden lg:block">
                            <h3 class="mb-4 text-lg font-semibold">Nuestra Ubicación</h3>
                            <div class="w-full rounded-lg overflow-hidden shadow-lg">
                                <iframe 
                                    class="w-full h-130" 
                                    frameborder="0" 
                                    scrolling="no" 
                                    marginheight="0" 
                                    marginwidth="0" 
                                    src="https://maps.google.com/maps?width=100%25&amp;height=600&amp;hl=en&amp;q=Av%20Las%20Carreras%207,%20Santiago%20de%20los%20Caballeros%2051000+(Consejo%20para%20el%20Desarrollo%20Estrat%C3%A9gico%20de%20Santiago)&amp;t=&amp;z=17&amp;ie=UTF8&amp;iwloc=B&amp;output=embed"
                                >
                                    <a href="https://www.mapsdirections.info/fr/calculer-la-population-sur-une-carte">
                                        Estimer la population sur la carte
                                    </a>
                                </iframe>
                            </div>
                            <p class="mt-2 text-sm text-muted-foreground">
                                Segundo Nivel, Edificio Empresarial, Av Las Carreras 7, Santiago de los Caballeros 51000
                            </p>
                            <p class="mt-5 text-sm text-muted-foreground">
                                Lunes - Viernes: 8:30 AM - 5:00 PM
                            </p>
                        </div>
                    </div>
                </div>
                <form action="" class="@container lg:col-span-3">
                    <Card className="p-8 sm:p-12">
                        <h3 class="text-xl font-semibold">
                            Vamos a dirigirte al lugar correcto
                        </h3>
                        <p class="mt-4 text-sm">
                            ¡Contacta a nuestro equipo de ventas! Nos encantaría
                            saber más sobre cómo planeas usar nuestra
                            aplicación.
                        </p>

                        <div
                            class="**:[&>label]:block mt-12 space-y-6 *:space-y-3"
                        >
                                <div>
                                    <Label htmlFor="name">
                                        Nombre completo
                                    </Label>
                                    <Input type="text" id="name" required />
                                </div>
                            <div>
                                    <Label htmlFor="email"
                                        >Correo electrónico de trabajo</Label
                                    >
                                    <Input type="email" id="email" required />
                            </div>
                            <div>
                                <Label htmlFor="phone">Número de teléfono</Label
                                >
                                <Input type="tel" id="phone" required />
                            </div>
                            <div>
                                <Label htmlFor="msg">Mensaje</Label>
                                <Textarea id="msg" rows={3} />
                            </div>
                            <Button>Enviar</Button>
                        </div>
                    </Card>
                </form>
            </div>
        </div>
        <!-- NUEVO: Mapa visible solo en mobile/tablet -->
            <div class="mt-12 lg:hidden">
                <h2 class="mb-6 text-2xl font-semibold">Nuestra Ubicación</h2>
                <div class="w-full rounded-lg overflow-hidden shadow-lg">
                    <iframe 
                        class="w-full h-64 sm:h-80" 
                        frameborder="0" 
                        scrolling="no" 
                        marginheight="0" 
                        marginwidth="0" 
                        src="https://maps.google.com/maps?width=100%25&amp;height=600&amp;hl=en&amp;q=Av%20Las%20Carreras%207,%20Santiago%20de%20los%20Caballeros%2051000+(Consejo%20para%20el%20Desarrollo%20Estrat%C3%A9gico%20de%20Santiago)&amp;t=&amp;z=17&amp;ie=UTF8&amp;iwloc=B&amp;output=embed"
                    >
                        <a href="https://www.mapsdirections.info/fr/calculer-la-population-sur-une-carte">
                            Estimer la population sur la carte
                        </a>
                    </iframe>
                </div>
                <p class="mt-4 text-sm text-muted-foreground">
                    Segundo Nivel, Edificio Empresarial, Av Las Carreras 7, Santiago de los Caballeros 51000
                </p>
                <p class="mt-5 text-sm text-muted-foreground">
                    Lunes - Viernes: 8:30 AM - 5:00 PM
                </p>
            </div>
        </div>
    </section>
</Layout>
