---
export const prerender = false;
import HeroSection from "@/components/Hero";
import NewsSection from "@/components/News";
import Welcome from "../components/Welcome.astro";
import Layout from "../layouts/Layout.astro";
import ContentSection from "@/components/astro/ContentSection.astro";
import CarouselVideos from "@/components/Videos";
import InfographySection from "@/components/astro/InfographySection.astro";
import { getData } from "lib/fetch";
const { Carrousel, Destacados, Plan } = await getData(
    "pagina-principal?populate[Carrousel][populate]=*&populate[Destacados][populate][articulos][populate]=*&populate[Plan][populate]=*",
);
---

<Layout>
    <HeroSection slides={Carrousel} client:only />
    <section class="bg-background py-16 dark:bg-transparent">
        <div class="mx-auto max-w-7xl px-6">
            <NewsSection
                news={Destacados.articulos}
                title={Destacados.Titulo}
                subtitle={Destacados.Subtitulo}
                client:only
            />
        </div>
    </section>
    <ContentSection
        title={Plan.Titulo}
        content={Plan.Contenido}
        media={Plan.Media}
        boton={Plan.Boton}
    />
    <CarouselVideos client:only />
</Layout>
