---
import Layout from '../layouts/Layout.astro';
import ProyectosSection from '@/components/Proyectos';
import { Card, CardContent, CardHeader } from '@/components/ui/card';
import { getData } from 'lib/fetch';

const { Titulo, Subtitulo, proyectos} = await getData("coleccion-de-proyecto?populate[proyectos][populate]=*");
console.log(proyectos)
---

<Layout>
    <main class="min-h-screen bg-background">
        <!-- Hero de proyectos -->
        <section class="bg-muted py-24">
            <div class="container mx-auto max-w-4xl px-6 text-center">
                <h1 class="text-5xl font-bold mb-6 font-playfair">
                    {Titulo}
                </h1>
                <p class="text-xl text-muted-foreground font-inter">
                    {Subtitulo}
                </p>
            </div>
        </section>

        <!-- Sección de proyectos -->
        <ProyectosSection proyectos={proyectos} client:load />
    </main>
</Layout>