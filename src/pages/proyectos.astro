---
export const prerender = false;
import Layout from "../layouts/Layout.astro";
import ProyectosSection from "@/components/Proyectos";
import { Resumen } from "@/components/resumen";
import { Card, CardContent, CardHeader } from "@/components/ui/card";
import { getData } from "lib/fetch";

const { Titulo, Subtitulo, proyectos } = await getData(
    "coleccion-de-proyecto?populate[proyectos][populate]=*",
);
function contarInstitucionesTotales(proyectos: any): number {
    return proyectos.reduce((total: any, proyecto: any) => {
        const count = Array.isArray(proyecto.instituciones)
            ? proyecto.instituciones.length
            : 0;
        return total + count;
    }, 0);
}

function filtrarProyectosNoCompletados(proyectos: any[]): any[] {
    return proyectos.filter((proyecto: any) => proyecto.Completado != true);
}
const proyectosNoCompletados = filtrarProyectosNoCompletados(proyectos);
---

<Layout>
    <main class="min-h-screen bg-background">
        <!-- Hero de proyectos -->
        <section class="bg-muted py-24">
            <div class="container mx-auto max-w-4xl px-6 text-center">
                <h1 class="text-5xl font-bold mb-6 font-playfair">
                    {Titulo}
                </h1>
                <p class="text-xl text-muted-foreground font-inter">
                    {Subtitulo}
                </p>
            </div>
        </section>

        <!-- Sección de proyectos -->
        <ProyectosSection proyectos={proyectosNoCompletados} client:load>
            <Resumen
                length={proyectosNoCompletados.length}
                instituciones={contarInstitucionesTotales(
                    proyectosNoCompletados,
                )}
            />
        </ProyectosSection>
    </main>
</Layout>
