---
import "../styles/globals.css";
import { Menu } from "../components/Menu";
import FooterSection from "@/components/astro/FooterSection.astro";
import { fetchWithCache } from "../../lib/cache";

let menuData = null;
let globalData = null;

try {
  // Perform both requests in parallel using the cache system
  const [menuResponse, globalResponse] = await Promise.all([
    fetchWithCache(
      `${import.meta.env.PUBLIC_STRAPI_URL}/api/navegacion?populate=*`,
      {
        headers: {
          Authorization: `Bearer ${import.meta.env.PUBLIC_STRAPI_KEY}`,
        },
      },
      'navigation'
    ),
    fetchWithCache(
      `${import.meta.env.PUBLIC_STRAPI_URL}/api/global?populate=*`,
      {
        headers: {
          Authorization: `Bearer ${import.meta.env.PUBLIC_STRAPI_KEY}`,
        },
      },
      'global'
    )
  ]);

  menuData = menuResponse;
  globalData = globalResponse;
} catch (error) {
  console.error("Error fetching layout data:", error);
  // Default values in case of error
  menuData = { data: { Paginas: [], Logo: null } };
  globalData = { data: { Titulo: "", Descripcion: "", Icono: { url: "" } } };
}

const { Titulo, Descripcion, Icono } = globalData?.data || {};
const { Paginas, Logo } = menuData?.data || {};

// Add default values to prevent undefined errors
const iconUrl = Icono?.url || "/default-icon.png";
const logoUrl = Logo?.url || "/default-logo.png";

---

<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
        <meta name="generator" content={Astro.generator} />

        <!-- Google Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Noto+Sans:ital,wght@0,100..900;1,100..900&family=Raleway&display=swap"
            rel="stylesheet"
        />
        <link
            rel="icon"
            type="image/svg+xml"
            href={`${import.meta.env.PUBLIC_STRAPI_URL}${iconUrl}`}
        />

        <title>{Titulo || "Título por defecto"}</title>
    </head>
    <body>
        <div class="flex justify-between items-center md:p-4">
            <Menu menuItems={Paginas || []} logo={logoUrl} client:only />

            <!-- Theme Toggle Button -->
            <!-- <button
                id="theme-toggle"
                class="p-2 rounded-md hover:bg-accent hover:text-accent-foreground transition-colors border border-border"
                aria-label="Toggle theme"
            >
                <span id="theme-icon" class="text-lg">🌙</span>
            </button> -->
        </div>

        <slot />

        <script>
            document.addEventListener("DOMContentLoaded", () => {
                const welcomeMessage =
                    "Bienvenido al Consejo para el Desarrollo Estratégico de Santiago.";
                const hasBeenWelcomed =
                    sessionStorage.getItem("hasBeenWelcomed");

                type StringMap = { [key: string]: string };

                if (!hasBeenWelcomed && "speechSynthesis" in window) {
                    const utterance = new SpeechSynthesisUtterance(
                        welcomeMessage,
                    );
                    utterance.lang = "es-ES";
                    speechSynthesis.speak(utterance);
                    sessionStorage.setItem("hasBeenWelcomed", "true");
                }

                const menuLinks = document.querySelectorAll("#main-menu a");
                const summaries: StringMap = {
                    "/nosotros":
                        "Aquí puedes conocer más sobre nosotros, nuestra historia y nuestro equipo.",
                    "/plan-estrategico-de-santiago":
                        "Descubre nuestro plan estratégico para el desarrollo de Santiago.",
                    "/proyectos":
                        "Explora los proyectos que estamos llevando a cabo para mejorar nuestra ciudad.",
                    "/biblioteca":
                        "Accede a nuestra biblioteca de recursos y documentos.",
                    "/noticias":
                        "Mantente al día con las últimas noticias y blogs.",
                    "/calendario":
                        "Consulta nuestro calendario de eventos y actividades.",
                    "/contacto": "Ponte en contacto con nosotros.",
                };

                menuLinks.forEach((link) => {
                    link.addEventListener("click", (event) => {
                        const href = link.getAttribute("href");
                        const summary = summaries[href as any];
                        const hasHeardSummary = sessionStorage.getItem(
                            `summary_${href}`,
                        );

                        if (
                            summary &&
                            !hasHeardSummary &&
                            "speechSynthesis" in window
                        ) {
                            // No prevenir la navegación, solo hablar
                            setTimeout(() => {
                                const utterance = new SpeechSynthesisUtterance(
                                    summary,
                                );
                                utterance.lang = "es-ES";
                                speechSynthesis.speak(utterance);
                                sessionStorage.setItem(
                                    `summary_${href}`,
                                    "true",
                                );
                            }, 100); // Pequeño retraso para asegurar que la navegación no interrumpa el habla
                        }
                    });
                });

                // Theme toggle functionality
                const themeToggle = document.getElementById("theme-toggle");
                const themeIcon = document.getElementById("theme-icon");

                function updateThemeIcon() {
                    if (themeIcon) {
                        const isDark =
                            document.documentElement.classList.contains("dark");
                        themeIcon.textContent = isDark ? "☀️" : "🌙";
                    }
                }

                if (themeToggle && themeIcon) {
                    themeToggle.addEventListener("click", () => {
                        const isDark =
                            document.documentElement.classList.contains("dark");
                        document.documentElement.classList.toggle("dark", !isDark);

                        // The existing MutationObserver will automatically save to localStorage
                        updateThemeIcon();
                    });

                    // Initial icon update
                    updateThemeIcon();
                }
            });
        </script>
        <FooterSection />
        
        <!-- Monitor de cache solo en desarrollo -->
        {import.meta.env.DEV && <div id="cache-monitor-root"></div>}
        
    </body>
</html>
