---
import { Button } from "@/components/ui/button";

const { title, content, media } = Astro.props;
---

<section class="py-16 md:py-32">
    <div class="mx-auto max-w-5xl space-y-8 px-6 md:space-y-16">
        <h2 class="relative z-10 max-w-xl text-4xl font-medium lg:text-5xl">
            {title}
        </h2>
        <div class="grid gap-6 sm:grid-cols-2 md:gap-12 lg:gap-24">
            <div class="relative mb-6 sm:mb-0">
                <div
                    class="aspect-76/59 relative rounded-2xl from-zinc-300 to-transparent p-px dark:from-zinc-700"
                >
                    <img
                        src={media.url.replace("https", "https:")}
                        class="rounded-[15px] dark:block"
                        alt="payments illustration dark"
                        width={1207}
                        height={929}
                    />
                </div>
            </div>

            <div class="relative space-y-4">
                {
                    content.map((paragraph: any) => {
                        return paragraph.children.map((item: any) => (
                            <p class="text-muted-foreground">{item.text}</p>
                        ));
                    })
                }

                <a
                    href="/plan-estrategico-de-santiago"
                    class="cursor-pointer hover:opacity-90 transition-opacity"
                >
                    <Button
                        variant="default"
                        className="cursor-pointer hover:shadow-lg transition-shadow"
                    >
                        Saber Más
                    </Button>
                </a>
            </div>
        </div>
    </div>
</section>
